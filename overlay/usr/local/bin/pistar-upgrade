#!/bin/sh
# pistar-upgrade - Download and install update to inactive A/B slot
# Part of Pi-Star OS

set -e

SLOT_CONF="/boot/firmware/slot.conf"
OS_CONF="/etc/pistar-os.conf"
OS_RELEASE="/etc/pistar-os-release"
TMP_DIR="/data/tmp"

# Exit codes: 0 = success (--check: update available), 1 = --check: up to
# date, 2 = error. Errors must not use 1 or callers will read "up to date".
die() { echo "Error: $*" >&2; exit 2; }

usage() {
	echo "Usage: pistar-upgrade [--check | --install]"
	echo "  --check    Check for available updates"
	echo "  --install  Download and install update to inactive slot"
	exit 2
}

[ "$(id -u)" -eq 0 ] || die "must be run as root"
[ -f "$SLOT_CONF" ] || die "$SLOT_CONF not found"
[ -f "$OS_CONF" ] || die "$OS_CONF not found"

# shellcheck disable=SC1090
. "$SLOT_CONF"
# shellcheck disable=SC1090
. "$OS_CONF"
# shellcheck source=../lib/pistar-os/bootslot.sh
. /usr/local/lib/pistar-os/bootslot.sh

# Two different "active" slots, deliberately kept apart:
#   RUNNING_SLOT - the slot whose rootfs is mounted as / right now (ground
#                  truth). This is the slot an upgrade must never reformat.
#   BOOT_TARGET  - the slot config.txt will boot NEXT (os_prefix); "" on the
#                  old shared layout.
# They are equal on a settled system and diverge only when an update is
# installed and waiting for a reboot.
RUNNING_SLOT=$(running_slot)
BOOT_TARGET=$(active_slot)

# Pick the install target from the RUNNING slot, so the slot we format is
# always the one not mounted - whatever config.txt claims. Fall back to
# config.txt, then slot.conf (ACTIVE_SLOT, already sourced), if the running
# slot cannot be read.
ACTIVE_SLOT="${RUNNING_SLOT:-${BOOT_TARGET:-$ACTIVE_SLOT}}"

case "$ACTIVE_SLOT" in
	A|B) INACTIVE_SLOT=$(other_slot "$ACTIVE_SLOT") ;;
	*) die "cannot determine the running slot" ;;
esac
INACTIVE_PART=$(slot_part "$INACTIVE_SLOT")
INACTIVE_DEV=$(slot_dev "$INACTIVE_SLOT")

# manifest_value KEY — print KEY's value from the downloaded manifest.
# The manifest comes from the network, so it is parsed rather than sourced.
manifest_value() {
	sed -n "s/^$1=//p" "$TMP_DIR/$MANIFEST_FILE" | head -1 | tr -d '"\r'
}

fetch_manifest() {
	mkdir -p "$TMP_DIR"
	if ! wget -q -O "$TMP_DIR/$MANIFEST_FILE" "$UPDATE_URL/$MANIFEST_FILE"; then
		die "failed to fetch manifest from $UPDATE_URL/$MANIFEST_FILE"
	fi

	VERSION=$(manifest_value VERSION)
	BUILD_DATE=$(manifest_value BUILD_DATE)
	ROOTFS_FILENAME=$(manifest_value ROOTFS_FILENAME)
	ROOTFS_SIZE=$(manifest_value ROOTFS_SIZE)   # compressed bytes, "" on older manifests

	case "$VERSION" in
		""|.*|*.|*..*|*[!0-9.]*) die "manifest has invalid VERSION: '$VERSION'" ;;
	esac
	case "$ROOTFS_FILENAME" in
		""|*[!A-Za-z0-9._-]*) die "manifest has invalid ROOTFS_FILENAME" ;;
	esac
}

# current_version — version of the running rootfs. /etc/pistar-os-release
# belongs to the slot itself, so it is authoritative; slot.conf is the
# fallback. Any " (build date)" suffix from older images is dropped.
current_version() {
	ver=""
	if [ -f "$OS_RELEASE" ]; then
		ver=$(sed -n 's/^Version:[[:space:]]*//p' "$OS_RELEASE" | head -1)
	fi
	if [ -z "$ver" ]; then
		case "$ACTIVE_SLOT" in
			A) ver="$SLOT_A_VERSION" ;;
			B) ver="$SLOT_B_VERSION" ;;
		esac
	fi
	echo "${ver%% *}"
}

# version_gt A B — true if version A is newer than version B. Versions are
# dot-separated numbers (YYYY.MM.DD.RR) compared field by field, so legacy
# versions like 5.0.0 sort below any date-based version. Non-numeric
# fields count as 0.
version_gt() {
	a="$1"
	b="$2"
	while [ -n "$a" ] || [ -n "$b" ]; do
		fa="${a%%.*}"
		fb="${b%%.*}"
		case "$a" in *.*) a="${a#*.}" ;; *) a="" ;; esac
		case "$b" in *.*) b="${b#*.}" ;; *) b="" ;; esac
		case "$fa" in ""|*[!0-9]*) fa=0 ;; esac
		case "$fb" in ""|*[!0-9]*) fb=0 ;; esac
		[ "$fa" -gt "$fb" ] && return 0
		[ "$fa" -lt "$fb" ] && return 1
	done
	return 1
}

check_update() {
	fetch_manifest

	CURRENT_VER=$(current_version)

	echo "Pi-Star OS Update Check"
	echo "Current:    ${CURRENT_VER:-unknown}"
	echo "Available:  ${VERSION} (${BUILD_DATE:-unknown})"
	echo "Active:     Slot $ACTIVE_SLOT"
	echo "Target:     Slot $INACTIVE_SLOT (partition $INACTIVE_PART)"

	# An update already installed and waiting for a reboot cannot be upgraded
	# over - report that instead of offering another install.
	if [ -n "$RUNNING_SLOT" ] && [ -n "$BOOT_TARGET" ] && [ "$RUNNING_SLOT" != "$BOOT_TARGET" ]; then
		echo "Status:     Reboot pending (an update is installed; reboot to activate)"
		return 1
	fi

	if [ -z "$CURRENT_VER" ] || version_gt "$VERSION" "$CURRENT_VER"; then
		echo "Status:     Update available"
		return 0
	else
		echo "Status:     Up to date"
		return 1
	fi
}

install_update() {
	# Boot files must be per slot, so installing never touches the running
	# slot's kernel. Older images are migrated by pistar-boot-layout at boot.
	[ -n "$BOOT_TARGET" ] || \
		die "the boot partition still uses the shared layout; reboot once so it can be migrated, then retry"

	# Refuse if an update is already installed and waiting for a reboot: the
	# running slot and the slot config.txt will boot next have diverged, so a
	# reboot - not another install - is what is needed. Authoritative and
	# physical; mirrors the dashboard's own guard.
	if [ -n "$RUNNING_SLOT" ] && [ -n "$BOOT_TARGET" ] && [ "$RUNNING_SLOT" != "$BOOT_TARGET" ]; then
		die "an update is already installed and waiting for a reboot (running slot $RUNNING_SLOT, next boot slot $BOOT_TARGET); reboot to activate it before upgrading again"
	fi

	# The target partition must exist and must not be mounted. The mount check
	# is the real safety net: whatever the slot bookkeeping says, never make a
	# filesystem on a mounted device.
	[ -b "$INACTIVE_DEV" ] || die "inactive slot device $INACTIVE_DEV not found"
	if awk -v d="$INACTIVE_DEV" '$1 == d { f = 1 } END { exit !f }' /proc/mounts 2>/dev/null; then
		die "refusing to install: target $INACTIVE_DEV is mounted"
	fi

	fetch_manifest

	# Enough room in TMP_DIR for the compressed rootfs download. Prefer the
	# exact size the manifest advertises (plus headroom for the checksum file
	# and filesystem overhead); fall back to a fixed floor for older manifests
	# that carry no size.
	mkdir -p "$TMP_DIR"
	need_kb=262144
	case "$ROOTFS_SIZE" in
		''|*[!0-9]*) ;;
		*) need_kb=$(( ROOTFS_SIZE / 1024 + 32768 )) ;;
	esac
	avail_kb=$(df -Pk "$TMP_DIR" 2>/dev/null | awk 'NR == 2 { print $4 }')
	if [ -n "$avail_kb" ] && [ "$avail_kb" -lt "$need_kb" ]; then
		die "not enough free space in $TMP_DIR: need ~$((need_kb / 1024)) MB, have $((avail_kb / 1024)) MB"
	fi

	ROOTFS_FILE="$ROOTFS_FILENAME"
	SHA_FILE="${ROOTFS_FILE}.sha256"

	echo "Downloading $ROOTFS_FILE..."
	mkdir -p "$TMP_DIR"

	if ! wget -O "$TMP_DIR/$ROOTFS_FILE" "$UPDATE_URL/$ROOTFS_FILE"; then
		die "failed to download rootfs tarball"
	fi

	if ! wget -q -O "$TMP_DIR/$SHA_FILE" "$UPDATE_URL/$SHA_FILE"; then
		die "failed to download checksum file"
	fi

	# Verify SHA256
	echo "Verifying checksum..."
	cd "$TMP_DIR"
	if ! sha256sum -c "$SHA_FILE"; then
		rm -f "$ROOTFS_FILE" "$SHA_FILE"
		die "checksum verification failed"
	fi
	cd /

	# Format inactive partition. Re-check the mount state right before mkfs in
	# case anything changed since the pre-flight checks.
	if awk -v d="$INACTIVE_DEV" '$1 == d { f = 1 } END { exit !f }' /proc/mounts 2>/dev/null; then
		die "refusing to format $INACTIVE_DEV: it is mounted"
	fi
	echo "Formatting $INACTIVE_DEV..."
	mkfs.ext4 -q -F "$INACTIVE_DEV"

	# Mount and extract
	MOUNT_DIR="/mnt/inactive"
	mkdir -p "$MOUNT_DIR"
	mount "$INACTIVE_DEV" "$MOUNT_DIR"

	echo "Extracting rootfs to slot $INACTIVE_SLOT..."
	tar -xJf "$TMP_DIR/$ROOTFS_FILE" -C "$MOUNT_DIR"

	# Build the new slot's boot directory from the extracted rootfs. The
	# running slot's directory is never touched.
	echo "Installing boot files for slot $INACTIVE_SLOT..."
	if ! install_slot_boot "$MOUNT_DIR/boot/firmware" "$INACTIVE_SLOT" \
		"$BOOTSLOT_FW_DIR/slot$ACTIVE_SLOT/cmdline.txt"; then
		umount "$MOUNT_DIR"
		rmdir "$MOUNT_DIR"
		die "could not install boot files for slot $INACTIVE_SLOT"
	fi

	umount "$MOUNT_DIR"
	rmdir "$MOUNT_DIR"

	# Switch the firmware to the new slot: one rewrite of config.txt
	set_active_slot "$INACTIVE_SLOT" || die "could not update config.txt"

	# Update slot.conf
	case "$INACTIVE_SLOT" in
		A) NEW_A_VER="$VERSION"; NEW_B_VER="$SLOT_B_VERSION" ;;
		B) NEW_A_VER="$SLOT_A_VERSION"; NEW_B_VER="$VERSION" ;;
	esac

	cat > "$SLOT_CONF" <<EOF
ACTIVE_SLOT=$INACTIVE_SLOT
PREVIOUS_SLOT=$ACTIVE_SLOT
PENDING=true
BOOT_TRIES=0
SLOT_A_VERSION="$NEW_A_VER"
SLOT_B_VERSION="$NEW_B_VER"
EOF

	sync

	# Clean up downloaded files
	rm -f "$TMP_DIR/$ROOTFS_FILE" "$TMP_DIR/$SHA_FILE" "$TMP_DIR/$MANIFEST_FILE"

	echo ""
	echo "Update installed to slot $INACTIVE_SLOT (version $VERSION)."
	echo "Reboot to activate: sudo reboot"
	echo "If the new version fails, automatic rollback will occur after 3 attempts."
}

case "$1" in
	--check)   check_update ;;
	--install) install_update ;;
	*)         usage ;;
esac
