#!/bin/sh
# pistar-rollback - Revert to previous A/B slot
# Part of Pi-Star OS

set -e

SLOT_CONF="/boot/firmware/slot.conf"
CMDLINE="/boot/firmware/cmdline.txt"

die() { echo "Error: $*" >&2; exit 1; }

[ "$(id -u)" -eq 0 ] || die "must be run as root"
[ -f "$SLOT_CONF" ] || die "$SLOT_CONF not found"

# shellcheck disable=SC1090
. "$SLOT_CONF"
# shellcheck source=../lib/pistar-os/bootslot.sh
. /usr/local/lib/pistar-os/bootslot.sh

FORCE=false
[ "$1" = "--force" ] && FORCE=true

[ -n "$PREVIOUS_SLOT" ] || die "no previous slot to roll back to"
PREV_PART=$(slot_part "$PREVIOUS_SLOT") || die "invalid PREVIOUS_SLOT: $PREVIOUS_SLOT"
PREV_DEV=$(slot_dev "$PREVIOUS_SLOT")

# The slot the firmware boots now; slot.conf on the old shared layout
BOOT_ACTIVE=$(active_slot)
[ -n "$BOOT_ACTIVE" ] && ACTIVE_SLOT="$BOOT_ACTIVE"

echo "Rolling back to slot $PREVIOUS_SLOT (partition $PREV_PART)..."

if [ -n "$BOOT_ACTIVE" ]; then
	# Per-slot boot directories: the previous slot's kernel, device trees
	# and overlays are intact, so switching os_prefix is all it takes.
	[ -d "$BOOTSLOT_FW_DIR/slot$PREVIOUS_SLOT" ] || \
		die "no boot files for slot $PREVIOUS_SLOT in $BOOTSLOT_FW_DIR/slot$PREVIOUS_SLOT"
	set_active_slot "$PREVIOUS_SLOT" || die "could not update config.txt"
else
	# Shared layout (boot-layout migration hasn't run): copy the previous
	# slot's kernel files back and point cmdline.txt at it.
	PREV_MNT="/tmp/rollback-mnt"
	mkdir -p "$PREV_MNT"
	cleanup() { umount "$PREV_MNT" 2>/dev/null; rmdir "$PREV_MNT" 2>/dev/null; }
	trap cleanup EXIT

	mount -o ro "$PREV_DEV" "$PREV_MNT" || die "failed to mount $PREV_DEV"
	[ -d "$PREV_MNT/boot/firmware" ] || die "no /boot/firmware in previous slot rootfs"

	for f in "$PREV_MNT"/boot/firmware/kernel*.img \
	         "$PREV_MNT"/boot/firmware/*.dtb; do
		[ -f "$f" ] || continue
		cp "$f" /boot/firmware/
	done

	umount "$PREV_MNT"
	rmdir "$PREV_MNT"
	trap - EXIT

	[ -f "$CMDLINE" ] || die "$CMDLINE not found"
	sed -i "s|root=/dev/mmcblk0p[0-9]*|root=${PREV_DEV}|" "$CMDLINE"
fi

# Update slot.conf: swap ACTIVE and PREVIOUS
cat > "$SLOT_CONF" <<EOF
ACTIVE_SLOT=$PREVIOUS_SLOT
PREVIOUS_SLOT=$ACTIVE_SLOT
PENDING=false
BOOT_TRIES=0
SLOT_A_VERSION="$SLOT_A_VERSION"
SLOT_B_VERSION="$SLOT_B_VERSION"
EOF

sync

echo "Rollback to slot $PREVIOUS_SLOT complete."

if [ "$FORCE" = "true" ]; then
	echo "Force mode: rebooting now..."
	reboot
else
	echo "Reboot to activate: sudo reboot"
fi
