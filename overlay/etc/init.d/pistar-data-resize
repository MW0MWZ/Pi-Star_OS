#!/sbin/openrc-run
# shellcheck shell=sh
# pistar-data-resize - Expand /data partition on first boot
# Part of Pi-Star OS
#
# Two-phase resize with automatic reboot:
#   Phase 1: parted expands the partition table entry, then reboots
#   Phase 2: kernel sees the real size at boot, resize2fs grows the fs
# This avoids partx and device-node race conditions entirely.

description="Pi-Star OS first-boot /data partition resize" # used by OpenRC
depend() {
	before localmount
}

DATA_DEV="/dev/mmcblk0p4"
DISK_DEV="/dev/mmcblk0"
PART_NUM=4

start() {
	# On Alpine e2fsck lives in /sbin while resize2fs and parted are in
	# /usr/sbin; make sure both directories are searched regardless of how the
	# init PATH is set, then call the tools by name.
	PATH="/sbin:/usr/sbin:$PATH"

	ebegin "Checking if /data partition needs resizing"

	# parted reads the ON-DISK partition table
	PART_END=$(parted -ms "$DISK_DEV" unit s print 2>/dev/null | \
		grep "^${PART_NUM}:" | cut -d: -f3 | tr -d 's')
	DISK_END=$(parted -ms "$DISK_DEV" unit s print 2>/dev/null | \
		grep "^${DISK_DEV}:" | cut -d: -f2 | tr -d 's')

	if [ -z "$PART_END" ] || [ -z "$DISK_END" ]; then
		ewarn "Could not determine partition layout"
		eend 1
		return 1
	fi

	SLACK=$(( DISK_END - PART_END ))

	if [ "$SLACK" -ge 32768 ]; then
		# Phase 1: partition table needs expanding
		einfo "Expanding /data partition to fill SD card..."
		parted -s "$DISK_DEV" resizepart "$PART_NUM" 100%
		einfo "Rebooting so kernel picks up new partition size..."
		eend 0
		sync
		reboot
		# Not reached
		return 0
	fi

	# Phase 2: partition is expanded, grow the filesystem.
	# The kernel read the correct partition size at boot, so resize2fs will
	# see the full size. P4 is not yet mounted (before localmount). resize2fs
	# refuses ("run e2fsck -f first") on a filesystem that has been mounted
	# since its last check, so the forced check must run - and must actually
	# succeed - before it.
	e2fsck -fy "$DATA_DEV" >/dev/null 2>&1
	rc=$?
	# e2fsck: 0 = clean, 1/2 = problems fixed (fine); 4+ = errors remain or it
	# could not run. Don't resize over an unchecked/broken filesystem.
	if [ "$rc" -ge 4 ]; then
		ewarn "e2fsck on $DATA_DEV returned $rc; leaving the resize for next boot"
		eend 1
		return 1
	fi

	if ! resize2fs "$DATA_DEV"; then
		ewarn "resize2fs failed on $DATA_DEV; leaving the resize for next boot"
		eend 1
		return 1
	fi

	einfo "/data partition resized successfully"

	# Only now that it has actually succeeded: disable this service for good.
	rc-update del pistar-data-resize boot

	eend 0
}
