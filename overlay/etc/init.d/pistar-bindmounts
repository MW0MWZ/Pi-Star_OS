#!/sbin/openrc-run
# shellcheck shell=sh
# pistar-bindmounts - Bind mount persistent /data/etc dirs over /etc
# Part of Pi-Star OS

description="Bind mount /data/etc/* directories over /etc/*"

depend() {
	need localmount
	before pistar-config networking wpa_supplicant dropbear
}

start() {
	ebegin "Bind mounting persistent /data/etc directories"

	for src in /data/etc/*/; do
		[ -d "$src" ] || continue
		name="${src%/}"
		name="${name##*/}"
		dest="/etc/$name"

		# Skip if no matching rootfs directory
		[ -d "$dest" ] || continue

		# Seed empty /data dirs from rootfs defaults
		if [ -z "$(ls -A "$src" 2>/dev/null)" ]; then
			cp -a "$dest/." "$src/"
		fi

		mount --bind "$src" "$dest"

		prune_stale_templates "$name"
	done

	eend 0
}

# Packages now ship configuration templates in /usr/share/<pkg>/ and
# nothing in /etc/<pkg>/. Templates that older packages left in
# /data/etc/<pkg>/ would otherwise persist across slot upgrades, so remove
# each one once the active slot provides its replacement. Pre-rename
# MMDVMHost/DisplayDriver templates are replaced by MMDVM-Host/MMDVM-Display.
prune_stale_templates() {
	pkg="$1"
	for tmpl in /etc/"$pkg"/*.ini.example; do
		[ -f "$tmpl" ] || continue
		base="${tmpl##*/}"
		case "$base" in
			MMDVMHost.ini.example) replacement="MMDVM-Host.ini.example" ;;
			DisplayDriver.ini.example) replacement="MMDVM-Display.ini.example" ;;
			*) replacement="$base" ;;
		esac
		[ -f "/usr/share/$pkg/$replacement" ] && rm -f "$tmpl"
	done
}

stop() {
	ebegin "Unmounting persistent /data/etc directories"

	for src in /data/etc/*/; do
		[ -d "$src" ] || continue
		name="${src%/}"
		name="${name##*/}"
		dest="/etc/$name"

		mountpoint -q "$dest" && umount "$dest"
	done

	eend 0
}
