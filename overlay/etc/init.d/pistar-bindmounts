#!/sbin/openrc-run
# shellcheck shell=sh
# pistar-bindmounts - Bind mount persistent /data directories over the rootfs
# Part of Pi-Star OS

description="Bind mount /data/etc/* and /data/var/lib/* over /etc and /var/lib" # used by OpenRC

# Each /data/<root>/<name>/ is bind-mounted over /<root>/<name>/.
PERSIST_ROOTS="etc var/lib"

# Always persisted: created on /data when the rootfs has them, so installs
# whose /data predates them pick them up too.
#   etc/dhcpcd          - dhcpcd.conf (static addressing written by Pi-Star MCP)
#   var/lib/pistar-mcp  - Pi-Star MCP state (host file updates, backups)
ENSURE_DIRS="etc/dhcpcd var/lib/pistar-mcp"

depend() {
	need localmount
	before pistar-config networking wpa_supplicant dhcpcd dropbear
}

start() {
	ebegin "Bind mounting persistent /data directories"

	for dir in $ENSURE_DIRS; do
		if [ -d "/$dir" ] && [ ! -d "/data/$dir" ]; then
			mkdir -p "/data/$dir"
		fi
	done

	for root in $PERSIST_ROOTS; do
		for src in /data/"$root"/*/; do
			[ -d "$src" ] || continue
			name="${src%/}"
			name="${name##*/}"
			dest="/$root/$name"

			# Skip if no matching rootfs directory
			[ -d "$dest" ] || continue

			# Seed empty /data dirs from rootfs defaults
			if [ -z "$(ls -A "$src" 2>/dev/null)" ]; then
				cp -a "$dest/." "$src/"
			fi

			mount --bind "$src" "$dest"

			[ "$root" = "etc" ] && prune_stale_templates "$name"
		done
	done

	eend 0
}

# Packages now ship configuration templates in /usr/share/<pkg>/ and
# nothing in /etc/<pkg>/. Templates that older packages left in
# /data/etc/<pkg>/ would otherwise persist across slot upgrades, so remove
# each one once the active slot provides its replacement. Pre-rename
# MMDVMHost/DisplayDriver templates are replaced by MMDVM-Host/MMDVM-Display.
prune_stale_templates() {
	pkg="$1"
	for tmpl in /etc/"$pkg"/*.ini.example; do
		[ -f "$tmpl" ] || continue
		base="${tmpl##*/}"
		case "$base" in
			MMDVMHost.ini.example) replacement="MMDVM-Host.ini.example" ;;
			DisplayDriver.ini.example) replacement="MMDVM-Display.ini.example" ;;
			*) replacement="$base" ;;
		esac
		[ -f "/usr/share/$pkg/$replacement" ] && rm -f "$tmpl"
	done
}

stop() {
	ebegin "Unmounting persistent /data directories"

	for root in $PERSIST_ROOTS; do
		for src in /data/"$root"/*/; do
			[ -d "$src" ] || continue
			name="${src%/}"
			name="${name##*/}"
			dest="/$root/$name"

			# /proc/mounts rather than mountpoint(1), which misses bind
			# mounts from the same filesystem
			grep -q " $dest " /proc/mounts && umount "$dest"
		done
	done

	eend 0
}
